# -------------------------------------------------------------
# Configuração da API — copie para ".env" e ajuste os valores.
# Em produção (NODE_ENV=production) TODAS as variáveis abaixo são
# obrigatórias: a API não inicia se alguma estiver ausente.
# -------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=corretor_admin
DATABASE_PASSWORD=seguro_tech_2024
DATABASE_NAME=calendario_seguros

# Chave de assinatura dos tokens JWT — use um valor longo e aleatório em produção
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Fuso horário usado para decidir "hoje" nos alertas e na conclusão de compromissos
APP_TIMEZONE=America/Sao_Paulo
